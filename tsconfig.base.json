{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@projectforge/schemas": ["./packages/schemas/src/index.ts"],
      "@projectforge/engine": ["./packages/engine/src/index.ts"],
      "@projectforge/registry": ["./packages/registry/src/index.ts"],
      "@projectforge/test-harness": ["./packages/test-harness/src/index.ts"],
      "@projectforge/cli": ["./packages/cli/src/index.ts"],
      "@projectforge/create-project": ["./packages/create-project/src/index.ts"]
    }
  }
}
